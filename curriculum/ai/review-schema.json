{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodingTestAIReview",
  "type": "object",
  "required": ["problem_key","verdict","score","dimensions","bugs","tests","review"],
  "properties": {
    "problem_key": {"type":"string"},
    "verdict": {"enum":["PASS","LIKELY_PASS","FAIL","NEED_TEST"]},
    "score": {"type":"integer","minimum":0,"maximum":100},
    "dimensions": {"type":"object","properties": {
      "correctness":{"type":"integer","minimum":0,"maximum":40},
      "time_complexity":{"type":"integer","minimum":0,"maximum":20},
      "space_complexity":{"type":"integer","minimum":0,"maximum":10},
      "algorithm_choice":{"type":"integer","minimum":0,"maximum":15},
      "implementation":{"type":"integer","minimum":0,"maximum":10},
      "explainability":{"type":"integer","minimum":0,"maximum":5}
    }},
    "estimated_time_complexity":{"type":["string","null"]},
    "estimated_space_complexity":{"type":["string","null"]},
    "bugs":{"type":"array","items":{"type":"string"}},
    "tests":{"type":"array","items":{"type":"string"}},
    "minimal_fix":{"type":["string","null"]},
    "alternative_approaches":{"type":"array","items":{"type":"string"}},
    "patterns_to_remember":{"type":"array","items":{"type":"string"}},
    "review":{"type":"string"}
  }
}
